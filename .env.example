# http：连接本机 Spring Boot；mock：离线演示账号。
BDS_AUTH_BACKEND=http
AUTH_API_URL=http://127.0.0.1:8080

# EEG：csv 只回放，lsl 才允许进入实机脑控链路。
BDS_EEG_BACKEND=csv
BDS_EEG_CSV_PATH=data/samples/start-1.csv
BDS_EEG_SAMPLE_RATE=250
BDS_EEG_FRAME_SIZE=32
BDS_LSL_STREAM_NAME=obci_eeg1
BDS_LSL_STREAM_TYPE=EEG

# FB-EEGNet 默认关闭；训练产生匹配的权重和 metadata 后再打开。
BDS_FB_EEGNET_ENABLED=false
BDS_FB_EEGNET_MODEL=models/fb_eegnet_fusion.pt
BDS_FB_EEGNET_METADATA=models/fb_eegnet_metadata.json

# disabled / crazyflie（Lighthouse 多机）/ flowdeck（仅单机人工验收）
BDS_SWARM_BACKEND=disabled
BDS_CRAZYFLIE_URIS=
BDS_HARDWARE_CONTROL_ENABLED=false
# 当前无 Lighthouse 硬件，默认关闭 Lighthouse 解锁检查。
BDS_REQUIRE_LIGHTHOUSE=false
# 无定位单机使用气压定高虚拟摇杆；只能辅助保高，不能锁定水平位置。
# 下列起降/点动参数保留给验收命令，虚拟摇杆主要使用倾角和发送频率。
BDS_BARE_MAX_TAKEOFF_HEIGHT=0.35
BDS_BARE_ASCENT_SPEED=0.15
BDS_BARE_DESCENT_SPEED=0.15
BDS_BARE_MOVE_DISTANCE=0.08
BDS_BARE_MOVE_PULSE=0.25
BDS_BARE_TILT_DEGREES=4.0
BDS_BARE_SETPOINT_RATE=50
# 必须现场测量，顺序：minX,maxX,minY,maxY,minZ,maxZ
BDS_SWARM_GEOFENCE=
BDS_SWARM_MIN_VBAT=3.5
BDS_SWARM_MIN_SPACING=0.55
BDS_SWARM_FORMATION_SPACING=0.8
BDS_SWARM_FORMATION_MAX_ERROR=0.15
# 仅填经重复校准和人工复核的 URI→米制补偿，例如 {"radio://.../01":0.01}
BDS_HEIGHT_OFFSETS_JSON={}
