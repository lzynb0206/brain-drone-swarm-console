# http：连接本机 Spring Boot；mock：离线演示账号。
BDS_AUTH_BACKEND=http
AUTH_API_URL=http://127.0.0.1:8080

# EEG：csv 只回放，lsl 才允许进入实机脑控链路。
BDS_EEG_BACKEND=csv
BDS_EEG_CSV_PATH=data/research_experiments/samples/start-1.csv
BDS_EEG_SAMPLE_RATE=250
BDS_EEG_FRAME_SIZE=8
BDS_EEG_WINDOW_SECONDS=2
BDS_EEG_DECISION_STEP_SECONDS=0.25
BDS_EEG_DATA_ROOT=data
BDS_LSL_STREAM_NAME=obci_eeg1
BDS_LSL_STREAM_TYPE=EEG
BDS_LSL_TIMEOUT=3

# FBCCA 识别门限。实验校准前不要随意降低。
BDS_FBCCA_MIN_SCORE=0.35
BDS_FBCCA_MIN_MARGIN=0.06

# 安全默认始终为 fbcca；个人模型可用于科研测试，通过独立验证后才允许实机执行。
BDS_INTENT_DECODER=fbcca
BDS_PERSONAL_TEMPLATE_MODEL=models/personal_template_ssvep_experimental.npz
BDS_PERSONAL_TEMPLATE_METADATA=models/personal_template_ssvep_experimental_metadata.json
BDS_LZY_PERSONAL_MODEL=models/personal_algorithm_lzy_experimental.npz
BDS_LZY_PERSONAL_METADATA=models/personal_algorithm_lzy_experimental_metadata.json
BDS_XZ_PERSONAL_MODEL=models/personal_algorithm_xz_experimental.npz
BDS_XZ_PERSONAL_METADATA=models/personal_algorithm_xz_experimental_metadata.json
BDS_TRANSFORMER_MODEL=models/transformer_ssvep.pt
BDS_TRANSFORMER_METADATA=models/transformer_ssvep_metadata.json
BDS_TRANSFORMER_MIN_CONFIDENCE=0.60
BDS_TRANSFORMER_REQUIRED_WINDOWS=2
BDS_TRANSFORMER_COOLDOWN_SECONDS=0.50

# FB-EEGNet 默认关闭；训练产生匹配的权重和 metadata 后再打开。
BDS_FB_EEGNET_ENABLED=false
BDS_FB_EEGNET_MODEL=models/fb_eegnet_fusion.pt
BDS_FB_EEGNET_METADATA=models/fb_eegnet_metadata.json

# disabled：禁用无人机接口；flowdeck：一架或多架 Crazyflie，支持 Flow + Lighthouse。
BDS_SWARM_BACKEND=disabled
BDS_CRAZYFLIE_URIS=
BDS_HARDWARE_CONTROL_ENABLED=false
BDS_SWARM_TAKEOFF_HEIGHT=0.4
BDS_SWARM_MOVE_DISTANCE=0.05
BDS_SWARM_MOVE_SPEED=0.15
BDS_SWARM_MIN_VBAT=3.2
BDS_SWARM_LOW_VOLTAGE_CONFIRM_S=1.0
BDS_FLOW_FAILURE_SAMPLES=3
BDS_FLOW_MIN_HEIGHT=0.2
BDS_FLOW_MAX_HEIGHT=2.0
BDS_FLOW_MAX_XY_SPEED=0.5
BDS_FLOW_MAX_Z_SPEED=0.5
BDS_FLOW_SETPOINT_RATE=5
BDS_FORMATION_SPACING=0.4
BDS_CFLIB_CACHE=.cache/cflib
