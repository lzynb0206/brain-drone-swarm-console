.DS_Store
.idea/
.cache/
.venv*/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.codex-finalizer/
build/
dist/
*.spec
artifacts/

# Local recordings, experiments and documents are never part of the software repository.
/data/
/outputs/
/output/
/research/
/results/
/reports/
/exports/
.codex-ppt-build/
.doc_review/
.env*
!.env.example

# Keep only the model required by the camera/gesture feature.
/models/*
!/models/dvs128_snn_best_v4.pth

# Ship device utilities and real recording export; retain experiment runners locally.
/scripts/*
!/scripts/expandable_eeg_config.py
!/scripts/expandable_eeg_lsl_bridge.py
!/scripts/expandable_eeg_openbci_serial_bridge.py
!/scripts/export_hybrid_pairs.py
